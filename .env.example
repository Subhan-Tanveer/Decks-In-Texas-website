# ── Copy this file to ".env" and fill in your values ──────────────────────────

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable.
VITE_GA_ID=

# Quote form backend endpoint. Options:
#   • Formspree:  https://formspree.io/f/yourid
#   • Netlify fn: /.netlify/functions/quote
#   • Your API:   https://api.decksintexas.com/quote
# Leave blank in development — the form will simulate a successful submit and
# log the payload to the console instead.
VITE_QUOTE_ENDPOINT=
